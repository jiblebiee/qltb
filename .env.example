# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit .env — file đã nằm trong .gitignore.

# -------- Cơ sở dữ liệu --------
DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/it_qltb?charset=utf8mb4

# -------- Chỉ dùng khi cài TRỌN GÓI bằng docker-compose.full.yml --------
# Bỏ qua cả khối này nếu công ty đã có sẵn MySQL và S3 riêng.
# scripts/setup.sh tự sinh mật khẩu ngẫu nhiên cho các dòng dưới.
APP_PORT=8000
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=it_qltb
MYSQL_USER=qltb
MYSQL_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Phải TRÙNG với AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY ở dưới
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -------- Lưu trữ ảnh (S3 / MinIO) --------
S3_ENDPOINT_URL=https://s3.example.com
# Địa chỉ kho ảnh nhìn từ TRÌNH DUYỆT. Chỉ điền khi khác S3_ENDPOINT_URL —
# ví dụ cài trọn gói bằng Docker: máy chủ gọi http://minio:9000 còn trình duyệt
# phải gọi http://<ip-máy-chủ>:9000. Bỏ trống nếu hai bên dùng chung địa chỉ.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=it-qltb
S3_REGION=ap-southeast-1
S3_PREFIX=images/
S3_IM_EXPORT=im_export/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRESIGN_EXPIRES=900

# -------- Ứng dụng --------
# Sinh khoá mới bằng:  python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=
# Chỉ dùng cho lần khởi động đầu tiên, tạo xong nên xoá khỏi .env
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASS=
# Danh sách origin được phép, phân tách bằng dấu phẩy. Để * là tắt cookie chéo site.
ALLOW_ORIGINS=*

# -------- Bảo mật --------
# Đặt true khi chạy sau HTTPS
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# -------- Nghiệp vụ --------
# Phiếu mượn không có hạn trả. Quá số ngày này chưa hoàn trả thì gửi cảnh báo
# tới trưởng bộ phận — ĐÚNG MỘT LẦN cho mỗi phiếu, không nhắc lại.
LOAN_OVERDUE_DAYS=10

# -------- Email --------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Giá trị có khoảng trắng hoặc dấu < > phải bọc nháy đơn
MAIL_FROM='IT Quan Ly Thiet Bi <no-reply@example.com>'
MAIL_ALERT_RECIPIENTS=
EMAIL_MANAGE=

# Phòng đứng ra cho mượn thiết bị. Phòng này được tạo sẵn lúc khởi động và là
# nguồn của ô "Người cho mượn" trong phiếu mượn. Mặc định: IT
LENDER_DEPARTMENT=IT
